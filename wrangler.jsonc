{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "forum-worker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],

  // 不绑定任何自定义域名（用户后期自行做 CF IP 优选与 DNS 配置），使用 workers.dev 默认免费域名

  // 内部服务 binding：同账号 worker 间公网互调被 CF 1042 拒绝，
  // 走 binding 内网通道（env.JUDGE / env.MAILER 优先，未配置才回退公网 URL）
  "services": [
    { "binding": "JUDGE", "service": "forum-ai" },
    { "binding": "MAILER", "service": "mailer" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forum-db-v3",
      "database_id": "24965a64-16db-4d9f-9cbf-7ef99a9eb030",
      "migrations_dir": "worker/migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    // Telegraph-Image 图床地址（部署图床后填入，如 https://your-telegraph.example.com）
    "TELEGRAPH_IMAGE_URL": "https://tubed.jgp.dpdns.org",
    // CORS 白名单：留空 = 回显任意 Origin（用户后期配好前端域名/IP 优选路由后可自行收紧为具体域名）
    "FRONTEND_URL": ""
  },

  // 定时任务：每天 00:00 UTC（北京时间 08:00）清理注销冷静期到期的账号
  // （requireAuth 懒触发之外的后台兜底，见 worker/src/index.ts scheduled）
  "triggers": {
    "crons": ["0 0 * * *"]
  },

  // AI 异步审核链路：发帖成功 → QUEUE.send({postId})（producer）→ 本 worker queue handler 消费
  // （读帖 → 调 judge（JUDGE_API_URL/JUDGE_API_KEY secrets + JUDGE service binding）→ 置信度分流 + 通知作者）。
  // 重试由队列内置 retries 承载（max_retries=3）；熔断（连续失败 20 次自动停用）在 aiReview.ts 内实现。
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "forum-ai-review" }],
    "consumers": [{ "queue": "forum-ai-review", "max_batch_size": 10, "max_retries": 3, "max_batch_timeout": 5 }]
  },
}
