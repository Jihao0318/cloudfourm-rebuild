{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "forum-worker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forum-db-v3",
      "database_id": "REPLACE_ON_CREATE",
      "migrations_dir": "worker/migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    // Telegraph-Image 图床地址（部署图床后填入，如 https://your-telegraph.example.com）
    "TELEGRAPH_IMAGE_URL": "",
    // CORS 白名单：前端线上域名（逗号分隔可配多个）。留空 = 回显任意 Origin（仅本地开发/旧行为兼容）；
    // 配置后，非白名单 Origin 的浏览器请求将返回 403。上线前请改为真实前端域名。
    "FRONTEND_URL": ""
  },

  // 定时任务：每天 00:00 UTC（北京时间 08:00）清理注销冷静期到期的账号
  // （requireAuth 懒触发之外的后台兜底，见 worker/src/index.ts scheduled）
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
