{
 "title": "CloudForum",
 "brief": "校园论坛客户端：帖子浏览与发布、评论互动、签到与积分经济、商城/仓库/抽奖、成就称号与会员体系。",
 "frame": "phone",
 "platform": "android",
 "paletteKey": "purple",
 "theme": {
  "dark": false,
  "bothModes": true,
  "contrast": "standard",
  "shape": "rounded",
  "font": "roboto",
  "emphasized": false,
  "motion": "expressive"
 },
 "frames": [
  {
   "id": "login",
   "name": "登录",
   "x": 0,
   "y": 0,
   "note": "邮箱密码登录；未验证邮箱先引导验证；忘记原密码走邮箱重置。"
  },
  {
   "id": "register",
   "name": "注册",
   "x": 492,
   "y": 0,
   "note": "用户名 3-20 字符（字母/数字/下划线/中文）；密码至少 6 位含大写字母和数字；邀请码按站点开关选填。"
  },
  {
   "id": "home",
   "name": "首页",
   "x": 984,
   "y": 0,
   "note": "帖子列表：最新/热门/浏览最多排序 + 板块筛选；置顶帖固定在顶部；FAB 发帖。"
  },
  {
   "id": "postDetail",
   "name": "帖子详情",
   "x": 1476,
   "y": 0,
   "note": "作者与正文（Markdown/图片/视频）、点赞/收藏/打赏/举报；付费帖先看价格，支付解锁后可查看 3 次；评论区直接回复。"
  },
  {
   "id": "createPost",
   "name": "发布帖子",
   "x": 1968,
   "y": 0,
   "note": "标题 + 正文（Markdown 图片/视频）+ 板块选择；付费帖仅限付费板块；发布后进巡查队列与 AI 审核；同一帖子的效果管理最多选 2 种（背景/推荐/高亮/运势）。"
  },
  {
   "id": "notifications",
   "name": "通知",
   "x": 0,
   "y": 1000,
   "note": "点赞/评论/系统/责令换邮箱通知；点击跳对应帖子或流程；支持全部已读。"
  },
  {
   "id": "me",
   "name": "我的",
   "x": 492,
   "y": 1000,
   "note": "资料头 + 全部功能入口：签到/钱包/商城/仓库/抽奖/排行/VIP/收藏/编辑资料/设置。"
  },
  {
   "id": "profile",
   "name": "个人主页",
   "x": 984,
   "y": 1000,
   "note": "背景图 + 头像 + 徽章（VIP/等级/称号）+ 帖子与成就两个标签；他人主页显示关注按钮。"
  },
  {
   "id": "editProfile",
   "name": "编辑资料",
   "x": 1476,
   "y": 1000,
   "note": "用户名、个人简介、自定义头衔（VIP）一次保存；S VIP+ 可换昵称主题。"
  },
  {
   "id": "checkin",
   "name": "每日签到",
   "x": 0,
   "y": 2000,
   "note": "连续签到积分 7 天一轮（+1/+2/+3/+5/+8/+13/+20），每次固定 +2 经验；积分发放没有每日上限。连续 30 天解锁全勤王。"
  },
  {
   "id": "coins",
   "name": "积分钱包",
   "x": 492,
   "y": 2000,
   "note": "余额、今日收入（发帖 2 次/评论 5 次/被赞 5 次/签到 1 次各计次数，无总分上限）与流水；可发起转账。"
  },
  {
   "id": "coinsTransfer",
   "name": "积分转账",
   "x": 984,
   "y": 2000,
   "note": "按用户名转积分；手续费按 VIP 等级递减，由转出方承担。"
  },
  {
   "id": "shop",
   "name": "积分商城",
   "x": 1476,
   "y": 2000,
   "note": "积分兑换道具：改名卡/置顶卡/头像框等，买后进道具仓库。"
  },
  {
   "id": "warehouse",
   "name": "道具仓库",
   "x": 1968,
   "y": 2000,
   "note": "我的道具（点击使用）与活跃效果（可摘除）；支持批量回收换积分。"
  },
  {
   "id": "lottery",
   "name": "幸运抽奖",
   "x": 0,
   "y": 3000,
   "note": "积分抽奖：奖池 SSR/SR/R/N 与保底；单抽或十连（十连享折扣）。"
  },
  {
   "id": "leaderboard",
   "name": "排行榜",
   "x": 492,
   "y": 3000,
   "note": "积分 Top 榜：前三名领奖台展示，其余按名次排列。"
  },
  {
   "id": "vip",
   "name": "VIP 会员",
   "x": 984,
   "y": 3000,
   "note": "三档会员：购买或差价升级；权益含签到加成/转账费率/上传上限。"
  },
  {
   "id": "changePassword",
   "name": "修改密码",
   "x": 1476,
   "y": 3000,
   "note": "验证当前密码后设置新密码；成功后所有设备登出。忘记原密码走登录页的邮箱重置。"
  },
  {
   "id": "changeEmail",
   "name": "更换邮箱",
   "x": 1968,
   "y": 3000,
   "note": "向新邮箱发 6 位验证码，验证通过即换绑；换绑会登出所有设备。"
  },
  {
   "id": "forgotPassword",
